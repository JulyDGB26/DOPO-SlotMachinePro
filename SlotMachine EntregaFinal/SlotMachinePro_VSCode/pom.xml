<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>edu.eci.dopo</groupId>
    <artifactId>slotmachinepro</artifactId>
    <version>1.0.0</version>
    <name>SlotMachinePro - Cierre Proyecto Inicial</name>
    <description>Migracion sin cambios funcionales del proyecto de BlueJ a VS Code.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <junit.version>5.13.4</junit.version>
    </properties>

    <dependencies>
        <!-- Pruebas C1 y C2: JUnit Jupiter. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Pruebas C3, C4 y aceptacion: JUnit 4 sin reescribir pruebas. -->
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Version alineada del lanzador utilizado por el proveedor de pruebas. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.13.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <!-- mvn test: las 123 pruebas UNITARIAS. -->
                    <!-- -Dtest=... permite ejecutar una aceptacion explicitamente. -->
                    <excludes>
                        <exclude>**/*AcceptanceTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>SlotMachineProGUI</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- FASE 2: JaCoCo mide cobertura de pruebas UNITARIAS sin alterar el dominio. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>preparar-agente-cobertura</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>generar-informe-cobertura</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- FASE 3: analisis estatico inicial con PMD.
                 No se vincula pmd:check a verify: la medicion inicial
                 debe generarse sin bloquear JaCoCo ni las pruebas. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.28.0</version>
                <configuration>
                    <!-- Analizar las 14 clases de produccion y las 8 clases de pruebas. -->
                    <includeTests>true</includeTests>
                    <targetJdk>17</targetJdk>
                    <format>xml</format>
                    <!-- Incluir todas las prioridades en el resultado inicial. -->
                    <minimumPriority>5</minimumPriority>
                    <renderRuleViolationPriority>true</renderRuleViolationPriority>
                    <renderViolationsByPriority>true</renderViolationsByPriority>
                    <skipEmptyReport>false</skipEmptyReport>
                    <!-- Para una validacion futura y explicita con pmd:check:
                         las prioridades numericas 1 (alta) y 2 (media alta)
                         se trataran como incumplimientos bloqueantes. -->
                    <failurePriority>2</failurePriority>
                    <failOnViolation>true</failOnViolation>
                    <linkXRef>false</linkXRef>
                    <!-- No especificar rulesets usa el conjunto predeterminado
                         oficial de maven-pmd-plugin 3.28.0. -->
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
